  {"op":"add-textbox","slide":"SLIDE_4","text":"ADAPTADORES PRIMARIOS\n(Driving Adapters)\n\n• Controladores REST Express\n• Rutas OpenAPI / Swagger 3.0\n• Consumidores de Colas BullMQ\n• Middlewares JWT, RBAC y Zod","x":35,"y":95,"width":205,"height":210,"font_size":12,"color":"#FFFFFF","font_family":"Roboto","background_color":"#334155","line_spacing":135},
