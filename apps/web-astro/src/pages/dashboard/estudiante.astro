---
import MainLayout from '../../layouts/MainLayout.astro';
import GradesTableIsland from '../../components/react/GradesTableIsland';
import CourseEnrollmentIsland from '../../components/react/CourseEnrollmentIsland';
import AsyncCertificateIsland from '../../components/react/AsyncCertificateIsland';
import {
  fetchOpenSections,
  fetchStudentSummary,
} from '../../services/apiClient';
import type {
  CourseSectionItem,
  StudentSummaryData,
} from '../../stores/academicStore';

const sessionUser = Astro.locals.user;
const token = Astro.locals.token;

// Aislamiento RBAC: Si un Docente o Admin intenta abrir la vista privada de estudiante, redirigir a su consola
if (sessionUser?.role === 'TEACHER' || sessionUser?.role === 'ADMIN') {
  return Astro.redirect('/dashboard/admin');
}

// El middleware garantiza una sesión verificada de rol STUDENT en esta ruta.
const studentId = sessionUser!.id;
const campusId = sessionUser!.campusId;

let initialSummary: StudentSummaryData | null = null;
let initialSections: CourseSectionItem[] = [];

let loadError: string | null = null;

try {
  initialSummary = await fetchStudentSummary(studentId, token);
} catch (err) {
  initialSummary = null;
  loadError = err instanceof Error ? err.message : 'No fue posible cargar tu expediente.';
}

try {
  initialSections = await fetchOpenSections({ campusId, studentId, token });
} catch {
  initialSections = [];
}

// Sin datos del backend se muestra "—": nunca cifras inventadas.
const pgaDisplay = initialSummary ? initialSummary.metrics.pga.toFixed(2) : '—';
const enrolledCreditsDisplay = initialSummary
  ? `${initialSummary.metrics.enrolledCredits} créditos · ${initialSummary.metrics.enrolledCoursesCount} cursos`
  : '—';
const campusDisplay = initialSummary
  ? `${initialSummary.student.campusName.split('-')[0].trim()} (${initialSummary.student.campusCode})`
  : sessionUser!.campusName || '—';
const CAMPUS_ADDRESSES: Record<string, string> = {
  NEI: 'Av. Pastrana Borrero · Neiva',
  PIT: 'Km 1 Vía Pitalito – Palestina',
  GAR: 'Cra. 3 No. 1-31 · Garzón',
  LPL: 'Km 1 Vía Fátima · La Plata',
};
const campusAddress = CAMPUS_ADDRESSES[initialSummary?.student.campusCode || sessionUser!.campusCode] || '';
const financialDisplay = initialSummary?.metrics.financialStatus || '—';
const isPaidUp = Boolean(initialSummary) && !/PENDIENTE/i.test(financialDisplay);
const studentFullName = initialSummary?.student.fullName || sessionUser!.fullName;
const studentCode = initialSummary?.student.studentCode || sessionUser!.studentCode || '—';
---

<MainLayout
  title="Expediente Académico del Estudiante"
  user={sessionUser}
>
  <div class="space-y-6">
    <!-- Encabezado Institucional de Expediente Estudiantil -->
    <section
      aria-label="Resumen de Perfil Académico del Estudiante"
      class="usco-gradient rounded-xl p-5 sm:p-6 border border-usco-gold/30 flex flex-col md:flex-row md:items-center justify-between gap-4"
    >
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold bg-[#070A12]/80 text-usco-gold border border-usco-gold/30">
            CÓDIGO: {studentCode}
          </span>
          <span class="px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-[#070A12]/80 text-slate-200 border border-slate-700/80">
            PERIODO 2026-2 · ACTIVO
          </span>
        </div>
        <h1 class="text-xl sm:text-3xl font-bold text-white tracking-tight">
          {studentFullName}
        </h1>
        <p class="text-xs sm:text-sm text-slate-200/90 mt-1">
          Ingeniería de Software · Facultad de Ingeniería · Universidad Surcolombiana
        </p>
      </div>

      <div class="flex items-center gap-3 self-start md:self-center">
        <div class="px-4 py-2.5 rounded-lg bg-[#070A12]/85 border border-slate-800 text-left md:text-right">
          <p class="text-[10px] font-mono uppercase tracking-wider text-slate-400">Sede</p>
          <p class="text-xs sm:text-sm font-semibold text-usco-gold mt-0.5">{campusDisplay}</p>
        </div>
      </div>
    </section>

    {loadError && (
      <div role="alert" class="rounded-xl border border-amber-700/60 bg-amber-950/40 px-4 py-3 text-sm text-amber-100">
        <strong class="font-semibold">No pudimos cargar tu expediente.</strong> {loadError}
        <a href="/dashboard/estudiante" class="ml-2 underline underline-offset-2 hover:text-white">Reintentar</a>
      </div>
    )}

    <!-- Indicadores Académicos del Semestre -->
    <section
      aria-label="Indicadores Clave de Rendimiento Académico (KPIs)"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"
    >
      <!-- KPI 1: Promedio General Acumulado (PGA) -->
      <div
        data-testid="pga-card"
        class="glass-card rounded-xl p-4 border border-slate-800 flex flex-col justify-between"
      >
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
            Promedio General (PGA)
          </span>
          <span class="px-1.5 py-0.5 rounded text-[10px] font-mono text-usco-gold bg-usco-wine/30 border border-usco-gold/25">
            30·30·40
          </span>
        </div>
        <div class="mt-2.5 flex items-baseline gap-1.5">
          <span
            id="kpi-pga-value"
            class="text-2xl font-mono font-bold text-usco-gold"
          >
            {pgaDisplay}
          </span>
          <span class="text-xs text-slate-500 font-mono">/ 5.00</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-1.5">
          Ponderado por créditos académicos
        </p>
      </div>

      <!-- KPI 2: Créditos Inscritos (2026-2) -->
      <div
        data-testid="credits-card"
        class="glass-card rounded-xl p-4 border border-slate-800 flex flex-col justify-between"
      >
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
            Carga Académica
          </span>
          <span class="px-1.5 py-0.5 rounded text-[10px] font-mono text-slate-300 bg-slate-900 border border-slate-800">
            2026-2
          </span>
        </div>
        <p
          id="kpi-credits-value"
          class="mt-2.5 text-lg font-mono font-bold text-white"
        >
          {enrolledCreditsDisplay}
        </p>
        <p class="text-[11px] text-slate-400 mt-1.5">
          Tope reglamentario: 21 créditos
        </p>
      </div>

      <!-- KPI 3: Sede Actual -->
      <div
        data-testid="campus-kpi-card"
        class="glass-card rounded-xl p-4 border border-slate-800 flex flex-col justify-between"
      >
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
            Sede Regional
          </span>
          <span class="px-1.5 py-0.5 rounded text-[10px] font-mono text-emerald-300 bg-emerald-950/80 border border-emerald-800/70">
            ACTIVA
          </span>
        </div>
        <p class="mt-2.5 text-base font-bold text-white truncate">
          {campusDisplay}
        </p>
        <p class="text-[11px] text-slate-400 mt-1.5">
          {campusAddress}
        </p>
      </div>

      <!-- KPI 4: Estado Financiero -->
      <div
        data-testid="financial-status-card"
        class="glass-card rounded-xl p-4 border border-slate-800 flex flex-col justify-between"
      >
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
            Estado Financiero
          </span>
          {initialSummary && (
            <span class:list={[
              'px-1.5 py-0.5 rounded text-[10px] font-mono border',
              isPaidUp
                ? 'text-emerald-300 bg-emerald-950/80 border-emerald-800/70'
                : 'text-amber-300 bg-amber-950/70 border-amber-700/70',
            ]}>
              {isPaidUp ? 'PAZ Y SALVO' : 'PENDIENTE'}
            </span>
          )}
        </div>
        <p class:list={['mt-2.5 text-base font-bold', isPaidUp ? 'text-emerald-400' : 'text-amber-300']}>
          {financialDisplay}
        </p>
        <p class="text-[11px] text-slate-400 mt-1.5">
          {isPaidUp ? 'Derechos de matrícula liquidados' : 'Tienes recibos de matrícula por pagar'}
        </p>
      </div>
    </section>

    <!-- Isla 1: Tabla de Calificaciones + Simulador de Corte 3 -->
    <section
      id="calificaciones"
      aria-label="Calificaciones Ponderadas y Simulador de Corte 3"
      class="min-w-0 max-w-full"
    >
      <GradesTableIsland
        client:load
        studentId={studentId}
        token={token}
        initialSummary={initialSummary}
      />
    </section>

    <!-- Grilla Inferior: Inscripción de Asignaturas + Certificados Oficiales PDF -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start min-w-0">
      <section
        id="matricula"
        aria-label="Inscripción de Asignaturas"
        class="lg:col-span-7 min-w-0 max-w-full"
      >
        <CourseEnrollmentIsland
          client:load
          studentId={studentId}
          campusId={campusId}
          token={token}
          initialSections={initialSections}
        />
      </section>

      <section
        id="certificados"
        aria-label="Solicitud de Certificados Académicos en PDF"
        class="lg:col-span-5 min-w-0 max-w-full"
      >
        <AsyncCertificateIsland
          client:load
          studentId={studentId}
          token={token}
          initialCertificates={initialSummary?.certificates || []}
        />
      </section>
    </div>
  </div>
</MainLayout>
