---
import MainLayout from '../../layouts/MainLayout.astro';
import AdminMultiCampusIsland from '../../components/react/AdminMultiCampusIsland';
import {
  fetchAdminEnrollments,
  fetchCampusesStats,
  fetchWorkerQueueMetrics,
  type WorkerQueueMetrics,
} from '../../services/apiClient';
import type {
  AdminEnrollmentRecord,
  CampusStatItem,
} from '../../stores/academicStore';

const sessionUser = Astro.locals.user;
const token = Astro.locals.token;

// Redirección de seguridad adicional por si un estudiante intenta abrir /dashboard/admin
if (sessionUser?.role === 'STUDENT') {
  return Astro.redirect('/dashboard/estudiante');
}

// El middleware garantiza una sesión verificada TEACHER o ADMIN en esta ruta.
const userRole = sessionUser!.role;
const userCampusCode = sessionUser!.campusCode;
const userFullName = sessionUser!.fullName;

let initialCampuses: CampusStatItem[] = [];
let initialEnrollments: AdminEnrollmentRecord[] = [];
let initialQueueMetrics: WorkerQueueMetrics | null = null;

try {
  initialCampuses = await fetchCampusesStats(token);
} catch {
  initialCampuses = [];
}

try {
  initialEnrollments = await fetchAdminEnrollments(token);
} catch {
  initialEnrollments = [];
}

try {
  initialQueueMetrics = await fetchWorkerQueueMetrics();
} catch {
  initialQueueMetrics = null;
}
---

<MainLayout
  title={userRole === 'TEACHER' ? 'Mis grupos y calificaciones' : 'Consolidado académico multi-sede'}
  user={sessionUser}
>
  <div class="space-y-6">
    <!-- Cabecera: identifica quién es y qué puede hacer en esta pantalla -->
    <section
      aria-label="Encabezado de la consola"
      class="usco-gradient rounded-xl p-5 sm:p-6 border border-usco-gold/30"
    >
      <p class="text-xs font-semibold uppercase tracking-wider text-usco-gold">
        {userRole === 'TEACHER' ? 'Docente' : 'Dirección de Registro y Control'} · Periodo 2026-2
      </p>
      <h1 class="mt-1 text-xl sm:text-3xl font-bold text-white tracking-tight">
        {userRole === 'TEACHER' ? 'Mis grupos y calificaciones' : 'Consolidado académico de las 4 sedes'}
      </h1>
      <p class="text-sm text-slate-200/90 mt-1">
        {userFullName}
        {userRole === 'TEACHER'
          ? ' · Registra las notas de los grupos que dictas.'
          : ' · Neiva, Pitalito, Garzón y La Plata.'}
      </p>
    </section>

    <!-- Isla React Aislada por Rol/Sede + Editor de Notas + Estado de Colas -->
    <div class="min-w-0 max-w-full">
      <AdminMultiCampusIsland
        client:load
        token={token}
        userRole={userRole}
        userCampusCode={userCampusCode}
        userFullName={userFullName}
        initialCampuses={initialCampuses}
        initialEnrollments={initialEnrollments}
        initialQueueMetrics={initialQueueMetrics}
      />
    </div>
  </div>
</MainLayout>
