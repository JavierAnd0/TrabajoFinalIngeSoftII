---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import ChatbotWidget from '../components/react/ChatbotWidget';
import UserProfileMenuIsland from '../components/react/UserProfileMenuIsland';
import type { SessionUser } from '../env';

interface Props {
  title: string;
  description?: string;
  user?: SessionUser | null;
  hideChatbot?: boolean;
}

const {
  title,
  description = 'Sistema Institucional de Gestión Académica Descentralizada — Universidad Surcolombiana (USCO)',
  user = Astro.locals.user,
  hideChatbot = false,
} = Astro.props;

const currentPath = Astro.url.pathname;

const CAMPUS_FULL_NAMES: Record<string, string> = {
  NEI: 'Sede Central Neiva',
  PIT: 'Sede Pitalito',
  GAR: 'Sede Garzón',
  LPL: 'Sede La Plata',
};

const activeCampusBadge = user
  ? user.role === 'ADMIN'
    ? 'Todas las sedes'
    : CAMPUS_FULL_NAMES[user.campusCode] || user.campusName?.split('-')[0]?.trim() || 'Sede Central Neiva'
  : 'Neiva · Pitalito · Garzón · La Plata';

// Documentación OpenAPI del Core, derivada de la URL pública configurada (no fija a localhost).
const swaggerUrl = `${(import.meta.env.PUBLIC_CORE_API_URL || 'http://localhost:4001/api/v1').replace(/\/api\/v1\/?$/, '')}/api/docs`;

// El asistente responde sobre el expediente del estudiante autenticado: solo se muestra a estudiantes.
const showChatbot = !hideChatbot && user?.role === 'STUDENT';

// Enlaces de navegación estrictamente aislados según el rol autenticado (Cero cruce de roles)
const roleNavLinks =
  user?.role === 'STUDENT'
    ? [
        { label: 'Calificaciones', href: '#calificaciones' },
        { label: 'Simulador', href: '#simulador' },
        { label: 'Matrícula', href: '#matricula' },
        { label: 'Certificados', href: '#certificados' },
      ]
    : user?.role === 'TEACHER'
      ? [
          { label: 'Planilla de notas', href: '#planilla' },
        ]
      : user?.role === 'ADMIN'
        ? [
            { label: 'Sedes', href: '#sedes' },
            { label: 'Planilla consolidada', href: '#planilla' },
            { label: 'Solicitudes', href: '#colas' },
          ]
        : [];
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#8B1E24" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Portal Académico USCO</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        try {
          var savedTheme = window.localStorage.getItem('usco_theme');
          if (savedTheme === 'light') {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
            document.documentElement.setAttribute('data-theme', 'light');
          } else {
            document.documentElement.classList.remove('light');
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          }
          var savedCompact = window.localStorage.getItem('usco_compact_tables') === 'true';
          document.documentElement.classList.toggle('compact-tables', savedCompact);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#070A12] text-slate-100 font-sans">
    <!-- Enlace de salto accesible WCAG AA -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg focus:bg-usco-gold focus:text-slate-950 focus:font-bold"
    >
      Saltar al contenido principal
    </a>

    <!-- Barra Superior Institucional Universidad Surcolombiana -->
    <header
      role="banner"
      aria-label="Cabecera Institucional Universidad Surcolombiana"
      class="sticky top-0 z-40 border-b border-slate-800/80 bg-[#070A12]/95 backdrop-blur-md"
    >
      <div class="usco-header-strip h-1 w-full"></div>
      <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2 sm:gap-4">
        <!-- Identidad Institucional -->
        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
          <a
            href={user ? (user.role === 'STUDENT' ? '/dashboard/estudiante' : '/dashboard/admin') : '/login'}
            class="flex items-center gap-2.5 sm:gap-3 group min-w-0"
            aria-label="Inicio Portal Académico Universidad Surcolombiana"
          >
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-usco-wine border border-usco-gold/50 flex flex-col items-center justify-center shrink-0 shadow-sm group-hover:border-usco-gold transition-colors">
              <span class="font-mono font-extrabold text-white text-[10px] sm:text-[11px] leading-none tracking-tighter">
                USCO
              </span>
              <span class="text-[8px] font-mono text-white/80 leading-none mt-0.5">
                1970
              </span>
            </div>
            <div class="truncate">
              <div class="flex items-center gap-2">
                <span class="font-bold text-white text-xs sm:text-base tracking-tight truncate">
                  Universidad Surcolombiana
                </span>
                <span class="hidden md:inline-block px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-slate-900 text-usco-gold border border-slate-700/80">
                  2026-2
                </span>
              </div>
              <p class="text-[10px] sm:text-[11px] text-slate-400 truncate">
                Sistema de Registro y Control Académico · Sedes Regionales
              </p>
            </div>
          </a>
        </div>

        <!-- Navegación Contextual Aislada por Rol + Menú de Perfil -->
        <nav
          aria-label="Navegación Principal del Sistema"
          class="flex items-center gap-2 sm:gap-2.5 shrink-0"
        >
          <!-- Indicador de Sede Asignada al Usuario -->
          <div
            data-testid="active-campus-indicator"
            class="hidden 2xl:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#0D1322] border border-slate-800 text-xs"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span class="text-slate-400">Jurisdicción:</span>
            <span class="font-medium text-slate-200">{activeCampusBadge}</span>
          </div>

          <!-- Enlaces internos exclusivos del rol actual (Sin permitir salto a otro rol) -->
          {user && roleNavLinks.length > 0 && (
            <div class="hidden lg:flex items-center bg-[#0D1322] p-0.5 rounded-lg border border-slate-800">
              {roleNavLinks.map((item) => (
                <a
                  href={item.href}
                  class="px-2.5 py-1.5 rounded-md text-xs font-medium text-slate-300 hover:text-white hover:bg-usco-wine/80 transition-colors"
                >
                  {item.label}
                </a>
              ))}
            </div>
          )}

          <!-- Enlace a documentación técnica: solo visible para Dirección de Registro (ADMIN) -->
          {user?.role === 'ADMIN' && (
          <a
            href={swaggerUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-testid="swagger-docs-link"
            class="hidden xl:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-[#0D1322] hover:bg-slate-800/80 text-slate-300 hover:text-usco-gold border border-slate-800 text-xs transition-colors"
            title="Documentación para integraciones"
          >
            <span>Documentación</span>
          </a>
          )}

          {user ? (
            <UserProfileMenuIsland client:load user={user} activeItemsCount={4} />
          ) : (
            currentPath !== '/login' && (
              <a
                href="/login"
                class="px-3.5 py-1.5 rounded-lg bg-usco-wine hover:bg-usco-wineLight text-white border border-usco-gold/30 text-xs font-semibold transition-colors"
              >
                Iniciar sesión
              </a>
            )
          )}
        </nav>
      </div>

      <!-- Barra de Navegación Rápida Móvil / Tablet (100% Responsive) -->
      {user && roleNavLinks.length > 0 && (
        <div class="lg:hidden border-t border-slate-800/80 bg-[#0D1322]/90 px-3 py-1.5 overflow-x-auto">
          <div class="flex items-center gap-1.5 min-w-max">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-usco-wine/30 text-usco-gold border border-usco-gold/30">
              {activeCampusBadge}
            </span>
            {roleNavLinks.map((item) => (
              <a
                href={item.href}
                class="px-2.5 py-1 rounded-md text-xs font-medium text-slate-300 hover:text-white hover:bg-usco-wine/70 transition-colors"
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      )}
    </header>

    <!-- Contenido Principal Accesible -->
    <main
      id="main-content"
      role="main"
      class="flex-1 max-w-7xl w-full min-w-0 overflow-x-hidden mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-7 pb-20 sm:pb-10"
    >
      <slot />
    </main>

    <!-- Pie de Página Institucional -->
    <footer
      role="contentinfo"
      class="border-t border-slate-900 bg-[#05080F] py-5 text-xs text-slate-400 mt-12"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
        <p>
          <strong class="text-slate-200 font-semibold">Universidad Surcolombiana (USCO)</strong> · NIT 891.180.084-2 · Neiva, Pitalito, Garzón y La Plata (Huila)
        </p>
        <p class="text-[11px] text-slate-400">
          Vicerrectoría Académica · Facultad de Ingeniería · Programa de Ingeniería de Software
        </p>
      </div>
    </footer>

    <!-- Widget Conversacional Flotante Persistente con ClientRouter -->
    {showChatbot && (
      <div transition:persist="chatbot-widget">
        <ChatbotWidget
          client:load
          token={Astro.locals.token}
          studentName={user?.fullName || ''}
        />
      </div>
    )}
  </body>
</html>
