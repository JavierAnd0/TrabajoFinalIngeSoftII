# ============================================================================
# 1. INFRAESTRUCTURA SUPABASE (PostgreSQL + Auth JWT + Storage)
# ============================================================================
# URL del proyecto Supabase (Cloud o instancia local en Docker)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
SUPABASE_STORAGE_BUCKET="academic-certificates"

# Conexión Prisma ORM al PostgreSQL de Supabase (Puerto 5432 o 6543 para Supavisor Pooler)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edudistribuida?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/edudistribuida?schema=public"

# ============================================================================
# 2. COLA DE MENSAJES DISTRIBUIDA (Redis + BullMQ)
# ============================================================================
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ============================================================================
# 3. PUERTOS Y URLS DE LOS MICROSERVICIOS (Arquitectura Hexagonal)
# ============================================================================
CORE_SERVICE_PORT="4001"
CORE_SERVICE_URL="http://localhost:4001"

WORKER_SERVICE_PORT="4002"
WORKER_SERVICE_URL="http://localhost:4002"

CHATBOT_SERVICE_PORT="4003"
CHATBOT_SERVICE_URL="http://localhost:4003"

PUBLIC_ASTRO_PORT="4321"
PUBLIC_CORE_API_URL="http://localhost:4001/api/v1"
PUBLIC_CHATBOT_API_URL="http://localhost:4003/api/v1/chat"

# ============================================================================
# 4. MOTOR DE IA GRATUITA PARA CHATBOT (Fase 3 - Híbrido con Fallback Determinista)
# ============================================================================
# Proveedor activo: "gemini" | "groq" | "deterministic"
AI_PROVIDER="gemini"
# Obtenible gratis en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Alternativa gratuita en https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
