{
  "name": "@edudistribuida/database",
  "version": "1.0.0",
  "private": true,
  "description": "Capa de persistencia distribuida con Prisma ORM y PostgreSQL/Supabase para EduDistribuida (USCO-Net)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate && tsc -p tsconfig.json",
    "db:push": "node ../../scripts/with-root-env.mjs prisma db push --accept-data-loss",
    "db:seed": "node ../../scripts/with-root-env.mjs tsx prisma/seed.ts",
    "build": "prisma generate && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
